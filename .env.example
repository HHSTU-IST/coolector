# ===== Relay Server 配置（全部可选，未设置时使用下方默认值）=====

# 接收端管理密钥。
# 设置非空后，除「发送方公开写」（POST /api/rooms/:roomId/uploads）与 SSE 一次性票据外的
# 所有 /api 请求都必须携带 `Authorization: Bearer <RELAY_TOKEN>`。
#
# 【安全 · fail-closed】未设置时仅允许监听回环地址（127.0.0.1 / localhost / ::1）；
# 若 HOST 为非回环（如 0.0.0.0）且未设置 token，服务将拒绝启动，防止公网裸奔。
#
# 【重要】该密钥只应存在于服务端与接收端浏览器（用户在界面上填写、存本机 localStorage）。
# 绝不要用 VITE_* 前缀把它注入前端产物 —— 那等于把管理凭据分发给每个发送方。
RELAY_TOKEN=

# 允许跨域的来源，逗号分隔；`*` 表示任意（默认）。部署到公网时务必收窄为具体域名。
# 留空 / 空串会被归一为 `*`，不会导致 CORS 头缺失。
RELAY_ALLOWED_ORIGINS=*

# 监听端口与地址。HOST 非回环时必须设置 RELAY_TOKEN（见上）。
# 注意：`pnpm start` 在 RELAY_TOKEN 为空时会**强制**把 relay 回退到 127.0.0.1（并打印提示），
# 因为「HOST=0.0.0.0 + 无令牌」会被 relay 的 fail-closed 检查拒绝启动。
PORT=8787
HOST=0.0.0.0

# 单个文件「解码后」的体积上限（字节），默认 10 MB。
# 与前端 src/stores/file.ts 的 MAX_FILE_SIZE 保持一致。
MAX_FILE_BYTES=10485760

# 信封 text 字段（docx 提取正文）的上限（字节），默认 1 MB。
# 前端只发前 256 KB；此项用于兜住第三方客户端塞入的超大正文。
MAX_TEXT_BYTES=1048576

# 单个请求体上限（字节）。默认由 MAX_FILE_BYTES 派生：
# base64 膨胀 4/3 + MAX_TEXT_BYTES + 128 KB 余量 ≈ 15.16 MB。
# 一般无需手动设置；只有当你要绕开派生值时才显式覆盖。
# MAX_BODY_BYTES=15160662

# 房间存活时间（毫秒），过期后自动清理并回收磁盘，默认 6 小时。
# 注意：上传会刷新这个空闲计时（活跃的收集不应被回收）。
ROOM_TTL_MS=21600000

# 房间绝对存活上限（毫秒），默认 24 小时。
# 没有这一层的话，「每 <ROOM_TTL_MS 传 1 字节」就能把房间与磁盘配额永久占住。
# 注意：该上限**不豁免已连接的接收端** —— 到点即回收，否则持一条 SSE 就能永久钉住房间。
ROOM_MAX_LIFETIME_MS=86400000

# 房间清理扫描周期（毫秒），默认 30 分钟
ROOM_CLEANUP_INTERVAL_MS=1800000

# 单个房间的上传条数上限，默认 500。即使每个文件都是 0 字节，也不能让房间无限增长。
MAX_ROOM_UPLOADS=500

# 单个房间的离线事件队列上限，默认 200。
# 接收端短暂断线时靠它重放事件；队列满则丢弃最旧事件，接收端重连后需重新拉取房间快照。
MAX_QUEUE_EVENTS=200

# 上传文件名上限（字节），默认 255。文件名会进入内存、房间快照、SSE 帧与审计日志，必须有界。
# 超长名会被截断（尽量保留扩展名）。
MAX_UPLOAD_NAME_BYTES=255

# 启动时是否保留「无主上传目录」，默认 false（即回收）。
# 房间只存在于内存：重启后磁盘上的文件已无法通过任何 HTTP 路径访问，却会被永久计入配额且无法回收。
# 设为 true 可保留在磁盘上人工抢救 —— 但它们仍计入配额，只能手工清理。
#
# ⚠️ 回收是**可判定**的：只删「目录内含本程序写的归属标记 `.coolector-room`、
# 且标记里的 roomId 与目录名一致」的目录。无标记 / 标记不匹配的目录一律不删、也不计入配额
# （启动日志会列出它们）。因此把 UPLOAD_DIR 指向共享数据根也不会误删无关数据。
RELAY_KEEP_ORPHAN_UPLOADS=false


# 上传落盘目录的磁盘配额（字节），超出后拒绝新上传（507），默认 1 GB。
MAX_TOTAL_UPLOAD_BYTES=1073741824

# 单个房间的配额上限（字节），默认取全局的 1/8（128 MB）。
# 免凭据的发送方最多只能填满「自己那个房间」，不会把全局配额吃光导致其它班级一起 507。
#
# 计费口径：正文 + 元数据（文件名/类型/时间）+ 服务端保留的文本字段。
# 文本类文件（.md/.ipynb/.json…）会同时保留原始字节与提取文本，占用约为文件大小的 2 倍，
# 若班上以文本类作业为主，可据此把该值调大一档。
MAX_ROOM_UPLOAD_BYTES=134217728

# 速率限制：每个来源 IP 在时间窗内的 /api 请求上限（默认 60 秒 120 次）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# 单个来源 IP 在同一时间窗内可写入的字节数，默认 256 MB（0 = 关闭）。
# 与请求计数限流互补：120 次 × 10 MB 这种量级的配额消耗只能靠字节数约束。
MAX_UPLOAD_BYTES_PER_WINDOW=268435456

# SSE 一次性票据有效期（毫秒），替代 URL 中的长期 token（默认 60 秒）
STREAM_TICKET_TTL_MS=60000

# 仅在可信反向代理（如 Caddy/Nginx）之后才设为 true，才会采信 x-forwarded-* 头。
# 【HTTPS 反代必开】否则服务端生成的回调地址是 http://，浏览器会拦截混合内容，
# SSE 与按需拉正文会同时失效。
RELAY_TRUST_PROXY=false

# 上传落盘目录
UPLOAD_DIR=./server/uploads

# ===== 前端（构建期注入，仅本地 dev / 自托管前端用，不打入镜像）=====

# 前端连接 Relay 的绝对地址。生产静态站部署时必须设置，否则前端默认
# 回退到 http://127.0.0.1:8787（仅本机开发可用，公网无效）。
# 例：VITE_RELAY_URL=https://relay.example.com
# 留空 = 本地默认（http://127.0.0.1:8787）
VITE_RELAY_URL=

# ⚠️ 这里刻意没有 VITE_RELAY_TOKEN。
# 前端产物是公开的，任何以 VITE_* 注入的密钥都会被内联进 dist/ 并被访问者提取。
# 接收端密钥改由用户在「公网接收长连接」面板填写，仅保存在本机 localStorage；
# 发送方（学生）则完全不需要密钥 —— 房间号本身就是能力凭据。
# 回归防护：`pnpm guard:no-secret` 会断言产物中不含密钥。
