# ===== Relay Server 配置 =====
#
# 【两层配置】旋钮按「运维是否真的需要调它」分层：
#
# ① 运维变量（就下面这几项，用 env 配置）：部署形态因环境而异，没有一套默认值能通吃 ——
#    RELAY_TOKEN / RELAY_ALLOWED_ORIGINS / PORT / HOST / MAX_FILE_BYTES /
#    MAX_TOTAL_UPLOAD_BYTES / RELAY_TRUSTED_PROXIES / RELAY_PUBLIC_BASE_URL / UPLOAD_DIR
#
# ② 内部调参（15 项，**模块常量，不能改 .env**）：房间 TTL、清理周期、条数上限、事件队列、
#    限流窗口与额度、SSE 票据有效期、文件名/正文长度上限等。它们互相耦合：请求体上限由
#    MAX_FILE_BYTES + 正文上限派生、房间配额默认取全局配额的 1/8。逐项暴露到 env 只会制造
#    「改了一个、另一个没跟上」的错配（曾实测：只调大 MAX_FILE_BYTES 而没重算派生上限，
#    带提取正文的 docx 有效上限掉到约 8.55 MB）。要改就改 `server/relay-config.js` 的
#    `TUNING_DEFAULTS`（每项都带一句「为什么是这个值」的注释）。
#
#    确有需要（测试，或确知自己在做什么）时走**唯一的显式覆盖通道** `RELAY_TUNING`（见文末）。

# 接收端管理密钥。
# 设置非空后，除「发送方公开写」（POST /api/rooms/:roomId/uploads）与 SSE 一次性票据外的
# 所有 /api 请求都必须携带 `Authorization: Bearer <RELAY_TOKEN>`。
#
# 【安全 · fail-closed】未设置时仅允许监听回环地址（127.0.0.1 / localhost / ::1）；
# 若 HOST 为非回环（如 0.0.0.0）且未设置 token，服务将拒绝启动，防止公网裸奔。
#
# 【重要】该密钥只应存在于服务端与接收端浏览器（用户在界面上填写、存本机 localStorage）。
# 绝不要用 VITE_* 前缀把它注入前端产物 —— 那等于把管理凭据分发给每个发送方。
RELAY_TOKEN=

# CORS 白名单，逗号分隔；`*` 表示任意来源（仅建议本机/内网使用）。
# **留空 = 不发送任何 CORS 头**（拒绝所有跨源前端），这是刻意的安全默认值：
# 发送方公开写路径本就免凭据，默认放开跨源等于允许任意站点向已知房间号灌文件。
# 同源部署（前端与 relay 同一个域名）无需配置；前后端不同源时必填，例：
#   RELAY_ALLOWED_ORIGINS=https://app.example.com
# 本机 `pnpm start` 会自动放行 localhost:5174。
# 前端部署到 GitHub Pages、Relay 由单条隧道（ngrok）暴露时，前端页面来自 Pages 域、与 relay
# 不同源 —— 那是跨源调用，需要把 Pages 域填进来，或临时用 `*`。
# 本机接收端与 Pages 前端是**两个不同的源**，都要列上，例：
#   RELAY_ALLOWED_ORIGINS=http://localhost:5174,https://<用户名>.github.io
RELAY_ALLOWED_ORIGINS=

# 监听端口与地址。HOST 非回环时必须设置 RELAY_TOKEN（见上）。
# 注意：`pnpm start` 在 RELAY_TOKEN 为空时会**强制**把 relay 回退到 127.0.0.1（并打印提示），
# 因为「HOST=0.0.0.0 + 无令牌」会被 relay 的 fail-closed 检查拒绝启动。
PORT=8787
HOST=0.0.0.0

# 单个文件「解码后」的体积上限（字节），默认 10 MB。
# 与前端 src/stores/file.ts 的 MAX_FILE_SIZE 保持一致。
# ⚠️ 调大它时请求体上限会自动重算（派生），无需手工同步。
MAX_FILE_BYTES=10485760

# 上传落盘目录的磁盘配额（字节），超出后拒绝新上传（507），默认 1 GB。
# 单个房间的配额默认取本值的 1/8（下限 8 MB）—— 免凭据的发送方最多只能填满「自己那个房间」，
# 不会把全局配额吃光导致其它班级一起 507。要单独调房间配额请走 `RELAY_TUNING`。
#
# 计费口径：正文 + 元数据（文件名/类型/时间）+ 服务端保留的文本字段。
# 文本类文件（.md/.ipynb/.json…）会同时保留原始字节与提取文本，占用约为文件大小的 2 倍，
# 若班上以文本类作业为主，可据此把本值调大一档。
MAX_TOTAL_UPLOAD_BYTES=1073741824

# 可信反向代理网段（IP / CIDR，逗号分隔）。
# 反代之后所有请求的 socket 地址都是**代理自己的 IP**：不声明这个变量，限流就退化成
# 「全站共用一个桶」—— 单个滥用者（或一个班的同一出口）足以让所有人 429。
# 声明后才按 `X-Forwarded-For` 的**最左**合法值分桶。例：
#   RELAY_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8,::1
# 直连部署留空即可（留空 = 不采信任何转发头，防止攻击者伪造 XFF 换桶绕过限流）。
RELAY_TRUSTED_PROXIES=

# 服务端对外 URL 的基址。**留空（默认）= 对外只输出相对路径**，由客户端按自己在界面上
# 填写的 Relay 地址解析。这是推荐形态，HTTPS 反代部署同样适用，无需额外配置
# （接收端填的就是 https://…，因此不会出现混合内容）。
#
# 【为什么不从请求头推断】`Host` / `x-forwarded-*` 完全由调用方控制，而接收端前端会自动
# 带着管理密钥去拉取服务端返回的 URL —— 无凭据的发送方只要伪造 `Host: evil.example`，
# 就能让接收端把 RELAY_TOKEN 发往攻击者域（F-001）。所以服务端只认这个显式配置。
#
# 只有**非浏览器客户端**（curl / 自定义集成）需要绝对 URL 时才设置，例如：
#   RELAY_PUBLIC_BASE_URL=https://relay.example.com
# 要求：不含凭据 / 查询串 / hash 的 http(s) 绝对地址，可带路径前缀（如 https://example.com/relay）。
# 非法值会让服务端拒绝启动（fail-closed）。
# 该判据与下面的 VITE_RELAY_URL 是**同一份实现**（shared/relay-base-url.js），
# 唯一的差异在「空值」的含义：这里留空 = 对外只输出相对路径（合法），
# 而 VITE_RELAY_URL 留空 = 前端未配置（校验报错）。
RELAY_PUBLIC_BASE_URL=

# 上传落盘目录
#
# 每个房间一个子目录，目录内除上传正文外还有一个 `room.json` —— 房间与上传的元数据。
# **重启不会丢作业**：服务启动时会按 `room.json` 重建房间与上传，并逐字节复原配额占用；
# 元数据引用的正文若已不在磁盘上，只跳过该条记录，其余照常恢复。
#
# ⚠️ 启动恢复**只读不删**：没有 `room.json`（或元数据损坏 / 与目录名不符）的目录一律
# 跳过并告警，既不删除也不计入配额。因此把 UPLOAD_DIR 指向共享数据根不会误删无关数据；
# 但如果你确认某个目录是本程序产生的，需人工清理（启动日志会列出无法识别的目录）。
UPLOAD_DIR=./server/uploads

# ===== 内部调参的显式覆盖通道（测试 / 高级用户）=====

# 一个 JSON 对象，键必须是下列 15 项之一，值必须是整数：
#   MAX_TEXT_BYTES  MAX_BODY_BYTES  MAX_QUEUE_EVENTS  MAX_ROOM_UPLOADS  MAX_UPLOAD_NAME_BYTES
#   MAX_ROOMS  MAX_UPLOAD_BYTES_PER_WINDOW  MAX_ROOM_BYTES_PER_WINDOW  MAX_ROOM_UPLOAD_BYTES
#   ROOM_TTL_MS  ROOM_MAX_LIFETIME_MS  ROOM_CLEANUP_INTERVAL_MS
#   STREAM_TICKET_TTL_MS  RATE_LIMIT_WINDOW_MS  RATE_LIMIT_MAX
#
# 注意：MAX_BODY_BYTES 与 MAX_ROOM_UPLOAD_BYTES 默认由其它配置派生，覆盖它们等于绕开派生。
# 两个窗口额度（MAX_UPLOAD_BYTES_PER_WINDOW / MAX_ROOM_BYTES_PER_WINDOW）可以设为 0 = 关闭。
#
# 例：RELAY_TUNING={"MAX_ROOMS":10,"RATE_LIMIT_MAX":9999}
#
# 未知键与非法值一律**拒绝启动**（fail-closed）：静默忽略未知键最危险 —— 运维会以为
# 改动生效了，实际跑的还是默认值，然后照着错误的旋钮排查问题。
RELAY_TUNING=

# ===== 前端（构建期注入，仅本地 dev / 自托管前端用）=====

# 前端连接 Relay 的地址。生产静态站部署时必须设置，否则前端默认
# 回退到 http://127.0.0.1:8787（仅本机开发可用，公网无效）。
# **必须是 http(s) 绝对地址**：判定来自 shared/relay-base-url.js，与前端运行期校验、
# 服务端启动检查（RELAY_PUBLIC_BASE_URL）及 `pnpm guard:no-secret` 共用同一份实现；
# 只有 CI 门禁（deploy.yml 的 shell 块）无法 import 该模块，需人肉同步。
# 裸相对路径（/relay）会被直接拒绝，也不接受凭据 / 查询串 / hash。同域挂子路径写成绝对形式即可：
#   VITE_RELAY_URL=https://app.example.com/relay
# 例：VITE_RELAY_URL=https://relay.example.com
# 留空 = 本地默认（http://127.0.0.1:8787）
VITE_RELAY_URL=

# ⚠️ 这里刻意没有 VITE_RELAY_TOKEN。
# 前端产物是公开的，任何以 VITE_* 注入的密钥都会被内联进 dist/ 并被访问者提取。
# 接收端密钥改由用户在「公网接收长连接」面板填写，仅保存在本机 localStorage；
# 发送方（学生）则完全不需要密钥 —— 房间号本身就是能力凭据。
# 回归防护：`pnpm guard:no-secret` 会断言产物中不含密钥。
