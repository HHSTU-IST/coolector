# ===== Relay Server 配置（全部可选，未设置时使用下方默认值）=====

# 接收端管理密钥。
# 设置非空后，除「发送方公开写」（POST /api/rooms/:roomId/uploads）与 SSE 一次性票据外的
# 所有 /api 请求都必须携带 `Authorization: Bearer <RELAY_TOKEN>`。
#
# 【安全 · fail-closed】未设置时仅允许监听回环地址（127.0.0.1 / localhost / ::1）；
# 若 HOST 为非回环（如 0.0.0.0）且未设置 token，服务将拒绝启动，防止公网裸奔。
#
# 【重要】该密钥只应存在于服务端与接收端浏览器（用户在界面上填写、存本机 localStorage）。
# 绝不要用 VITE_* 前缀把它注入前端产物 —— 那等于把管理凭据分发给每个发送方。
RELAY_TOKEN=

# 允许跨域的来源，逗号分隔；`*` 表示任意（默认）。部署到公网时务必收窄为具体域名。
# 留空 / 空串会被归一为 `*`，不会导致 CORS 头缺失。
RELAY_ALLOWED_ORIGINS=*

# 监听端口与地址。HOST 非回环时必须设置 RELAY_TOKEN（见上）。
# 注意：`pnpm start` 在 RELAY_TOKEN 为空时会自动把 relay 回退到 127.0.0.1。
PORT=8787
HOST=0.0.0.0

# 单个文件「解码后」的体积上限（字节），默认 10 MB。
# 与前端 src/stores/file.ts 的 MAX_FILE_SIZE 保持一致。
MAX_FILE_BYTES=10485760

# 单个请求体上限（字节）。默认由 MAX_FILE_BYTES 派生（×4/3 的 base64 膨胀 + 64 KB 余量）。
# 一般无需手动设置；只有当你要绕开派生值时才显式覆盖。
# MAX_BODY_BYTES=14076011

# 房间存活时间（毫秒），过期后自动清理并回收磁盘，默认 6 小时
ROOM_TTL_MS=21600000

# 上传落盘目录的磁盘配额（字节），超出后拒绝新上传，默认 1 GB
MAX_TOTAL_UPLOAD_BYTES=1073741824

# 速率限制：每个来源 IP 在时间窗内的 /api 请求上限（默认 60 秒 120 次）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# SSE 一次性票据有效期（毫秒），替代 URL 中的长期 token（默认 60 秒）
STREAM_TICKET_TTL_MS=60000

# 仅在可信反向代理（如 Caddy/Nginx）之后才设为 true，才会采信 x-forwarded-* 头。
# 【HTTPS 反代必开】否则服务端生成的回调地址是 http://，浏览器会拦截混合内容，
# SSE 与按需拉正文会同时失效。
RELAY_TRUST_PROXY=false

# 上传落盘目录
UPLOAD_DIR=./server/uploads

# ===== 前端（构建期注入，仅本地 dev / 自托管前端用，不打入镜像）=====

# 前端连接 Relay 的绝对地址。生产静态站部署时必须设置，否则前端默认
# 回退到 http://127.0.0.1:8787（仅本机开发可用，公网无效）。
# 例：VITE_RELAY_URL=https://relay.example.com
# 留空 = 本地默认（http://127.0.0.1:8787）
VITE_RELAY_URL=

# ⚠️ 这里刻意没有 VITE_RELAY_TOKEN。
# 前端产物是公开的，任何以 VITE_* 注入的密钥都会被内联进 dist/ 并被访问者提取。
# 接收端密钥改由用户在「公网接收长连接」面板填写，仅保存在本机 localStorage；
# 发送方（学生）则完全不需要密钥 —— 房间号本身就是能力凭据。
# 回归防护：`pnpm guard:no-secret` 会断言产物中不含密钥。
