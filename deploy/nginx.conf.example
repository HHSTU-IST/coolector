# Coolector Relay Server 反向代理（Nginx + Let's Encrypt）
# 文档见仓库 RELAY_DEPLOY.md
# 配合 certbot 使用：certbot --nginx -d relay.example.com
server {
    listen 80;
    server_name relay.example.com;
    # certbot 会自动补充 443 / ssl_certificate 等
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name relay.example.com;

    # SSL 由 certbot 注入：
    # ssl_certificate /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;

    # SSE 与上传：关闭缓冲、保持长连接、透传协议头
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://127.0.0.1:8787;
    proxy_cache off;
    proxy_buffering off;          # 关键：SSE 不缓冲，事件实时下发
    chunked_transfer_encoding on;
    client_max_body_size 20m;     # 允许单文件最大 20MB，需 >= RELAY MAX_BODY_BYTES
}
